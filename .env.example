# GEMINI_API_KEY: Primary key for One. real-time Gemini Live voice AI, emotional companion, and tool control.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: Primary AI engine key for AI Hub, translation, and discovery.
# When omitted, EARTH ONE routes automatically through DeepSeek open direct relay.
DEEPSEEK_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Web deployment (production) ---
# NODE_ENV=production and/or EARTH_ONE_SERVE_DIST=true: serve built dist/ (same-origin frontend+API+WS).
# PORT: listen port (default 3000).
# CORS_ORIGIN: for split deployment only (Pages frontend -> separate API), comma-separated allowed origins or *.
# VITE_API_BASE: build-time frontend API/WS base for split deployment (leave empty for same-origin). Set in CI/Pages env.
# EARTH_ONE_SKIP_BOOK_HARVEST=true: skip background book harvest in constrained environments.
# PERSISTENCE: production MUST run with persistent disk/volume mounted for server_data/, server_data.json, discovery.db*, uploads, books (do not use ephemeral FS).

# 宇宙浏览器全局搜索：优先使用真实 Google 搜索结果。
# 配置 SERPER_API_KEY 后启用 Serper 网页搜索和真实图片搜索（免费额度以 Serper 当前方案为准）。
# 获取地址：https://serper.dev （注册后在 Dashboard 获取 API Key）。
# 未配置时自动回退 Bing / DuckDuckGo / Wikipedia 免费搜索。
SERPER_API_KEY=""

# Optional DeepSeek / OpenAI-compatible provider defaults (DeepSeek / Ollama / vLLM).
CUSTOM_BASE_URL="https://api.deepseek.com/v1"
CUSTOM_MODEL="deepseek-chat"
CUSTOM_API_KEY=""

# --- EARTH ONE GLOBAL AI (ONE AI) ---
# ONE_AI_ENCRYPTION_KEY: 32-byte secret passphrase for AES-256-GCM encrypted provider key storage in one_ai.db
# ONE_AI_ADMIN_EMAILS: Comma-separated admin emails allowed to open ONE AI Admin Console
ONE_AI_ENCRYPTION_KEY=""
ONE_AI_ADMIN_EMAILS=""
GROQ_API_KEY=""
CEREBRAS_API_KEY=""
OPENROUTER_API_KEY=""
KILO_API_KEY=""
DASHSCOPE_API_KEY=""
ZHIPU_API_KEY=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
HF_TOKEN=""

# OpenAlex, Crossref, arXiv, Europe PMC, PMC and PubMed require no account or API key.
# Most WORLD LIBRARY connectors do not need a key. Google Books requires a server-side API key;
# the connector stays disabled until GOOGLE_BOOKS_API_KEY is configured.
# Europeana requires a server-side API key; the connector stays disabled until EUROPEANA_API_KEY is configured.
# Open Library recommends an identifiable User-Agent; set a contact address if available.
# Shamela uses its official free read-only MCP endpoint and needs no API key or Shamela account.
EARTH_ONE_LIBRARY_CONTACT_EMAIL=""
GOOGLE_BOOKS_API_KEY=""
EUROPEANA_API_KEY=""
EARTH_ONE_LIBRARY_OPENLIBRARY_ENABLED="true"
EARTH_ONE_LIBRARY_GUTENBERG_ENABLED="true"
EARTH_ONE_LIBRARY_ARCHIVE_ENABLED="true"
EARTH_ONE_LIBRARY_GOOGLEBOOKS_ENABLED="true"
EARTH_ONE_LIBRARY_EUROPEANA_ENABLED="true"
EARTH_ONE_LIBRARY_WIKISOURCE_ENABLED="true"
EARTH_ONE_LIBRARY_AR_WIKISOURCE_ENABLED="true"
EARTH_ONE_LIBRARY_OPENALEX_ENABLED="true"
EARTH_ONE_LIBRARY_CROSSREF_ENABLED="true"
EARTH_ONE_LIBRARY_ARXIV_ENABLED="true"
EARTH_ONE_LIBRARY_EUROPEPMC_ENABLED="true"
EARTH_ONE_LIBRARY_PMC_ENABLED="true"
EARTH_ONE_LIBRARY_PUBMED_ENABLED="true"
EARTH_ONE_LIBRARY_SHAMELA_ENABLED="true"

# --- Official channel integrations (optional) ---
# Google Sign-In (OAuth 2.0 / OpenID Connect)
# Create OAuth client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# WeChat Open Platform (website QR login/binding, official only; no personal chat sync)
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# WhatsApp Business Platform (Cloud API, official business messaging only; no personal WhatsApp)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# Telegram Bot (official Bot API bridge)
TELEGRAM_BOT_TOKEN=""

# --- ONE Communication (LiveKit SFU + coturn TURN) ---
# When LIVEKIT_URL, LIVEKIT_API_KEY, and LIVEKIT_API_SECRET are configured cleanly,
# ONE Communication issues short-lived 10-minute room tokens backed by LiveKit SFU.
# Without LiveKit, ONE uses P2P WebRTC + STUN/TURN (+ WS audio fallback on restricted NAT).
# LIVEKIT_URL: Server-side reachable LiveKit HTTP/WS endpoint (e.g. https://livekit.yourdomain.com)
# LIVEKIT_PUBLIC_URL: Client-facing WSS endpoint (defaults to LIVEKIT_URL if omitted, e.g. wss://livekit.yourdomain.com)
LIVEKIT_URL=""
LIVEKIT_PUBLIC_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# coturn TURN relay (recommended: both UDP/TCP 3478 and TLS 5349 on TCP 443 or 5349)
TURN_URL=""
TURN_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
ICE_SERVERS_JSON=""

# --- ONE Network Mode B (System-level WireGuard VPN Node Registry) ---
# Public WireGuard node metadata ONLY — NEVER put server or client private keys here.
# Example JSON array:
# ONE_NETWORK_NODES_JSON='[{"id":"sg-1","name":"Singapore WireGuard 01","region":"ap-southeast-1","countryCode":"SG","endpoint":"sg-vpn.example.com","listenPort":51820,"publicKey":"<SERVER_WG_PUBLIC_KEY>","subnetCidr":"10.66.0.0/16","dnsServers":["1.1.1.1","9.9.9.9"],"mtu":1280,"allowedIps":["0.0.0.0/0","::/0"],"healthCheckUrl":"https://sg-vpn.example.com/health"}]'
ONE_NETWORK_NODES_JSON=""
# Set "true" only in automated local/E2E tests probing localhost health endpoints.
ONE_NETWORK_ALLOW_LOCAL_PROBE="false"

