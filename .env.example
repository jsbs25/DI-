# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# 宇宙浏览器全局搜索：优先使用真实 Google 搜索结果。
# 配置 SERPER_API_KEY 后启用 Serper 网页搜索和真实图片搜索（免费额度以 Serper 当前方案为准）。
# 获取地址：https://serper.dev （注册后在 Dashboard 获取 API Key）。
# 未配置时自动回退 Bing / DuckDuckGo / Wikipedia 免费搜索。
SERPER_API_KEY=""

# Optional OpenAI-compatible provider defaults (Ollama / vLLM / OpenRouter / other gateways).
# The AI Hub configuration drawer can override these values for the current process.
CUSTOM_BASE_URL="http://localhost:11434/v1"
CUSTOM_MODEL="llama3"
CUSTOM_API_KEY=""

# OpenAlex, Crossref, arXiv, Europe PMC, PMC and PubMed require no account or API key.
# Most WORLD LIBRARY connectors do not need a key. Google Books requires a server-side API key;
# the connector stays disabled until GOOGLE_BOOKS_API_KEY is configured.
# Europeana requires a server-side API key; the connector stays disabled until EUROPEANA_API_KEY is configured.
# Open Library recommends an identifiable User-Agent; set a contact address if available.
# Shamela uses its official free read-only MCP endpoint and needs no API key or Shamela account.
EARTH_ONE_LIBRARY_CONTACT_EMAIL=""
GOOGLE_BOOKS_API_KEY=""
EUROPEANA_API_KEY=""
EARTH_ONE_LIBRARY_OPENLIBRARY_ENABLED="true"
EARTH_ONE_LIBRARY_GUTENBERG_ENABLED="true"
EARTH_ONE_LIBRARY_ARCHIVE_ENABLED="true"
EARTH_ONE_LIBRARY_GOOGLEBOOKS_ENABLED="true"
EARTH_ONE_LIBRARY_EUROPEANA_ENABLED="true"
EARTH_ONE_LIBRARY_WIKISOURCE_ENABLED="true"
EARTH_ONE_LIBRARY_AR_WIKISOURCE_ENABLED="true"
EARTH_ONE_LIBRARY_OPENALEX_ENABLED="true"
EARTH_ONE_LIBRARY_CROSSREF_ENABLED="true"
EARTH_ONE_LIBRARY_ARXIV_ENABLED="true"
EARTH_ONE_LIBRARY_EUROPEPMC_ENABLED="true"
EARTH_ONE_LIBRARY_PMC_ENABLED="true"
EARTH_ONE_LIBRARY_PUBMED_ENABLED="true"
EARTH_ONE_LIBRARY_SHAMELA_ENABLED="true"

# --- Official channel integrations (optional) ---
# Google Sign-In (OAuth 2.0 / OpenID Connect)
# Create OAuth client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# WeChat Open Platform (website QR login/binding, official only; no personal chat sync)
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# WhatsApp Business Platform (Cloud API, official business messaging only; no personal WhatsApp)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# Telegram Bot (official Bot API bridge)
TELEGRAM_BOT_TOKEN=""
