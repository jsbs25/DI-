{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "trustedDependencies": [
    "electron"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "desktop:dev": "node desktop/launcher.cjs",
    "test:download-manager": "node desktop/test-download-manager.cjs",
    "test:session-store": "node desktop/test-session-store.cjs",
    "test:browser-find": "node desktop/test-browser-find.cjs",
