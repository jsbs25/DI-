    "test:browser-engine": "npm run test:download-manager && npm run test:session-store && npm run test:browser-find && npm run test:browser-popups && npm run test:browser-ipc-security && npm run test:browser-permissions && xvfb-run -a node desktop/test-browser-integration.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:api": "tsx scripts/test_api.ts",
    "test:globe-api": "tsx scripts/test_globe_api.ts",
    "test:ai-api": "tsx scripts/test_ai_api.ts",
    "test:ai-provider": "tsx scripts/test_openai_compatible_provider.ts",
    "test:knowledge-api": "tsx scripts/test_knowledge_api.ts",
    "test:library-api": "tsx scripts/test_library_api.ts",
    "test:library-reading-ai": "tsx scripts/test_library_reading_ai.ts",
    "test:library-epub-security": "tsx scripts/test_library_epub_security.ts",
    "test:library-connectors": "tsx scripts/test_library_connectors.ts",
    "test:library-connector-isolation": "tsx scripts/test_library_connector_isolation.ts",
    "test:library-search-filters": "tsx scripts/test_library_search_filters.ts",
    "test:library-connectors:live": "tsx scripts/test_library_connectors_live.ts",
    "test:crawler-api": "tsx scripts/test_crawler_api.ts",
    "test:creator-api": "tsx scripts/test_creator_api.ts",
    "test:catalog-api": "tsx scripts/test_catalogs_api.ts",
    "test:social-feed-api": "tsx scripts/test_social_feed_api.ts",
    "test:public-users-api": "tsx scripts/test_public_users_api.ts",
    "test:browser-api": "tsx scripts/test_browser_api.ts",
    "test:i18n": "tsx scripts/test_i18n.ts",
    "test:motion": "tsx scripts/test_motion_accessibility.ts",
    "test:motion:browser": "tsx scripts/test_motion_accessibility_browser.ts",
    "test:motion:build": "npm run build && tsx scripts/test_motion_accessibility_build.ts",
    "test:globe": "tsx scripts/test_globe_render.tsx",
    "test:universe": "tsx scripts/test_universe_render.tsx"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "epubjs": "^0.3.93",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.2.2",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
