  "articles": [
    {
      "id": "art_1",
      "authorId": "user_fr_1",
      "author": {
        "displayName": "Julien Moreau",
        "username": "julien_paris",
        "avatar": "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=150&auto=format&fit=crop&q=80",
        "countryCode": "FR"
      },
      "title": "The Digital Agora: Reclaiming Human Connection Across Continents",
      "summary": "Why spatial awareness and cultural translation are replacing the algorithmic echo chambers of the first internet era.",
      "content": "When we look at the night sky or view our blue planet from orbit, no political borders are visible. The lights of cities shine as interconnected constellations of human warmth, work, and wonder.\n\nThe first era of social media flattened human geography into 2D algorithmic engagement traps. In contrast, Earth One reconstructs the digital space around authentic planetary presence: you can feel the physical distance, celebrate cultural specificity, and instantly dissolve language barriers through artificial intelligence.\n\nWhen an architect in Beijing speaks with a researcher in California and an entrepreneur in Riyadh, true mutual civilizational enrichment occurs. Let us cultivate this shared planet together.",
      "coverUrl": "https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1000&auto=format&fit=crop&q=80",
      "category": "Philosophy & Society",
      "readTime": "6 min read",
      "clapsCount": 428,
      "clapped": false,
      "tipsTotal": 240,
      "createdAt": "2026-11-01T14:00:00Z"
    },
    {
      "id": "art_2",
      "authorId": "user_cn_1",
      "author": {
        "displayName": "Li Wei (李伟)",
        "username": "li_wei",
        "avatar": "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80",
        "countryCode": "CN"
      },
      "title": "Modern Timber & Biophilic Architecture for 21st-Century Megacities",
      "summary": "A deep dive into cross-laminated timber, passive airflow, and centuries of Chinese mortise-and-tenon craftsmanship.",
      "content": "For thousands of years, ancient master carpenters built pagodas that survived 8.0-magnitude earthquakes without a single metal nail. The secret lies in flexible mortise and tenon joints that dissipate seismic kinetic energy.\n\nToday, combining this ancestral heritage with satellite parametric modeling and engineered timber allows us to build carbon-negative skyscrapers. By returning to biological materials, our cities transform from concrete canyons into breathing vertical forests.",
      "coverUrl": "https://images.unsplash.com/photo-1513694203232-719a280e022f?w=1000&auto=format&fit=crop&q=80",
      "category": "Architecture & Nature",
      "readTime": "8 min read",
      "clapsCount": 312,
